# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL (Deploy VPS Ubuntu com Prisma)
DATABASE_URL="postgresql://csdk_app:TROCAR_SENHA@127.0.0.1:5432/csdk_db?schema=public"

# Autenticação JWT Backend API (api.dkfacilita.com)
JWT_SECRET="SUBSTITUIR_POR_SEGREDO_FORTE_64_CHARS"
JWT_EXPIRES_IN="7d"

# Mercado Pago: configurar somente após homologação da conta e dos webhooks.
MERCADO_PAGO_ACCESS_TOKEN="SUBSTITUIR"
MERCADO_PAGO_PUBLIC_KEY="SUBSTITUIR"
MERCADO_PAGO_WEBHOOK_SECRET="SUBSTITUIR"

# Domínios do Ecossistema DK Facilita
SITE_URL="https://dkfacilita.com"
APP_CLIENT_URL="https://certifica.dkfacilita.com"
ADMIN_URL="https://admin.dkfacilita.com"
API_URL="https://api.dkfacilita.com"
