# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL (Deploy VPS Ubuntu com Prisma)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/dkfacilita_certifica?schema=public"

# Autenticação JWT Backend API (api.dkfacilita.com)
JWT_SECRET="SUBSTITUIR_POR_SEGREDO_FORTE_64_CHARS"
JWT_EXPIRES_IN="7d"

# Gateway de Pagamento Asaas (Produção / Sandbox)
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_API_KEY="SUA_CHAVE_API_ASAAS"
ASAAS_WEBHOOK_TOKEN="TOKEN_SECRETO_WEBHOOK_ASAAS"

# Domínios do Ecossistema DK Facilita
SITE_URL="https://dkfacilita.com"
APP_CLIENT_URL="https://certifica.dkfacilita.com"
ADMIN_URL="https://admin.dkfacilita.com"
API_URL="https://api.dkfacilita.com"
