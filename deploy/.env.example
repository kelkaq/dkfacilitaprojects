# ==============================================================================
# Variáveis de Ambiente — Produção VPS Ubuntu (DK Facilita / Certifica Software - DK)
# Copie este arquivo para a raiz do projeto como `.env` e preencha os valores reais.
# NUNCA versione o arquivo `.env` com credenciais reais no GitHub.
# ==============================================================================

NODE_ENV="production"
PORT="3000"

# Banco de Dados PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://csdk_app:TROCAR_SENHA_FORTE@127.0.0.1:5432/csdk_db?schema=public"

# Autenticação JWT Backend API (gere com: openssl rand -hex 32)
JWT_SECRET="SUBSTITUIR_POR_SEGREDO_FORTE_64_CHARS"
JWT_EXPIRES_IN="7d"
CSDK_COOKIE_AUTH="1"

# Mercado Pago: credenciais privadas somente no servidor, após homologação.
MERCADO_PAGO_ACCESS_TOKEN="SUBSTITUIR"
MERCADO_PAGO_PUBLIC_KEY="SUBSTITUIR"
MERCADO_PAGO_WEBHOOK_SECRET="SUBSTITUIR"
CSDK_PAYMENT_ENVIRONMENT="PRODUCTION"
RESEND_API_KEY="SUBSTITUIR"
EMAIL_FROM="DK Facilita <contato@dkfacilita.com>"

# Em homologação isolada, use TEST e MERCADO_PAGO_TEST_ACCESS_TOKEN.
# Não habilite ofertas TEST no site público.
MERCADO_PAGO_TEST_ACCESS_TOKEN="SUBSTITUIR_EM_HOMOLOGACAO"

# Domínios Oficiais do Ecossistema DK Facilita
APP_URL="https://dkfacilita.com"
SITE_URL="https://dkfacilita.com"
APP_CLIENT_URL="https://certifica.dkfacilita.com"
ADMIN_URL="https://admin.dkfacilita.com"
API_URL="https://api.dkfacilita.com"
