rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES & IDENTITY HELPERS
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'kelvinkarsonn@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isTenantOwner(empresaId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/empresas/$(empresaId)) &&
        get(/databases/$(database)/documents/empresas/$(empresaId)).data.ownerUid == request.auth.uid;
    }

    function isTenantMember(empresaId) {
      return isSignedIn() && (
        isTenantOwner(empresaId) ||
        exists(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.uid))
      );
    }

    function isValidTimestamp(val) {
      return val is timestamp;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalInt(data, field) {
      return !(field in data) || data[field] == null || (data[field] is int);
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] == null || (data[field] is number);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] == null || (data[field] is bool);
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || (data[field] is timestamp);
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS — CATÁLOGO GLOBAL
    // =========================================================================

    function isValidPlano(data) {
      return data.keys().hasAll([
          'slug', 'nome', 'subtitulo', 'descricao', 'precoMensalCentavos',
          'descontoSemestral', 'descontoAnual', 'limiteColaboradores',
          'limiteUsuarios', 'limiteObras', 'incluiCartaAnuencia',
          'incluiDossieLink', 'incluiAlertasWpp', 'incluiDominioProprio',
          'destaque', 'ativo', 'ordem', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'nome', 'subtitulo', 'descricao', 'precoMensalCentavos',
          'precoPromocionalCentavos', 'seloPromocional',
          'descontoSemestral', 'descontoAnual', 'limiteColaboradores',
          'limiteUsuarios', 'limiteObras', 'incluiCartaAnuencia',
          'incluiDossieLink', 'incluiAlertasWpp', 'incluiDominioProprio',
          'destaque', 'ativo', 'ordem', 'createdAt', 'updatedAt'
        ]) &&
        isOptionalString(data, 'id', 128) &&
        isOptionalTimestamp(data, 'createdAt') &&
        isOptionalInt(data, 'precoPromocionalCentavos') &&
        isOptionalString(data, 'seloPromocional', 60) &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 64 &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 100 &&
        data.subtitulo is string && data.subtitulo.size() <= 200 &&
        data.descricao is string && data.descricao.size() <= 600 &&
        data.precoMensalCentavos is int && data.precoMensalCentavos >= 0 && data.precoMensalCentavos <= 100000000 &&
        data.descontoSemestral is int && data.descontoSemestral >= 0 && data.descontoSemestral <= 80 &&
        data.descontoAnual is int && data.descontoAnual >= 0 && data.descontoAnual <= 80 &&
        data.limiteColaboradores is int && data.limiteColaboradores >= 1 &&
        data.limiteUsuarios is int && data.limiteUsuarios >= 1 &&
        data.limiteObras is int && data.limiteObras >= 1 &&
        data.incluiCartaAnuencia is bool &&
        data.incluiDossieLink is bool &&
        data.incluiAlertasWpp is bool &&
        data.incluiDominioProprio is bool &&
        data.destaque is bool &&
        data.ativo is bool &&
        data.ordem is int &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdicional(data) {
      return data.keys().hasAll([
          'slug', 'nome', 'descricao', 'precoMensalCentavos',
          'tipoCobranca', 'recursoChave', 'incrementoQtd', 'ativo', 'ordem', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'nome', 'descricao', 'precoMensalCentavos',
          'tipoCobranca', 'recursoChave', 'incrementoQtd', 'ativo', 'ordem',
          'createdAt', 'updatedAt'
        ]) &&
        isOptionalString(data, 'id', 128) &&
        isOptionalTimestamp(data, 'createdAt') &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 64 &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 120 &&
        data.descricao is string && data.descricao.size() <= 600 &&
        data.precoMensalCentavos is int && data.precoMensalCentavos >= 0 &&
        data.tipoCobranca in ['RECORRENTE', 'UNICO'] &&
        data.recursoChave is string && data.recursoChave.size() >= 2 && data.recursoChave.size() <= 64 &&
        data.incrementoQtd is int && data.incrementoQtd >= 0 &&
        data.ativo is bool &&
        data.ordem is int &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidNrGlobal(data) {
      return data.keys().hasAll([
          'codigo', 'titulo', 'descricao', 'baseLegal',
          'validadePadraoMeses', 'ativa', 'ordem', 'variacoes', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'codigo', 'titulo', 'descricao', 'baseLegal',
          'validadePadraoMeses', 'ativa', 'ordem', 'variacoes',
          'createdAt', 'updatedAt'
        ]) &&
        isOptionalString(data, 'id', 128) &&
        isOptionalTimestamp(data, 'createdAt') &&
        data.codigo is string && data.codigo.size() >= 2 && data.codigo.size() <= 20 &&
        data.titulo is string && data.titulo.size() >= 3 && data.titulo.size() <= 240 &&
        data.descricao is string && data.descricao.size() <= 800 &&
        data.baseLegal is string && data.baseLegal.size() <= 240 &&
        data.validadePadraoMeses is int && data.validadePadraoMeses >= 1 && data.validadePadraoMeses <= 120 &&
        data.ativa is bool &&
        data.ordem is int &&
        data.variacoes is list && data.variacoes.size() <= 20 &&
        (data.variacoes.size() == 0 || data.variacoes[0] is map) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidModeloCertificado(data) {
      return data.keys().hasAll([
          'slug', 'nome', 'descricao', 'categoria', 'previewCssToken',
          'layoutConfig', 'ativo', 'ordem', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'nome', 'descricao', 'categoria', 'previewCssToken',
          'layoutConfig', 'ativo', 'ordem', 'createdAt', 'updatedAt'
        ]) &&
        isOptionalString(data, 'id', 128) &&
        isOptionalTimestamp(data, 'createdAt') &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 64 &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 120 &&
        data.descricao is string && data.descricao.size() <= 500 &&
        data.categoria in ['GRATUITO', 'PREMIUM'] &&
        data.previewCssToken is string && data.previewCssToken.size() <= 64 &&
        data.layoutConfig is map &&
        data.ativo is bool &&
        data.ordem is int &&
        isValidTimestamp(data.updatedAt);
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS — EMPRESA & SUBCOLEÇÕES MULTIEMPRESA
    // =========================================================================

    function isValidEmpresa(data) {
      return data.keys().hasAll([
          'ownerUid', 'cnpj', 'razaoSocial', 'emailFinanceiro',
          'whatsapp', 'corPrimaria', 'prefixoCertificado',
          'status', 'onboardingConcluido', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid', 'tipoPessoa', 'cnpj', 'razaoSocial', 'nomeFantasia', 'nomeAdministrador',
          'emailFinanceiro', 'whatsapp', 'cupomAplicado', 'descontoCupomCentavos',
          'certificadoNomeExibicao', 'certificadoExibirDocumento',
          'certificadoTelefoneRodape', 'certificadoEmailRodape',
          'cep', 'logradouro', 'numero', 'complemento', 'bairro',
          'endereco', 'cidade', 'uf', 'logoUrl',
          'corPrimaria', 'corSecundaria', 'prefixoCertificado',
          'modeloCertificadoId', 'modeloProprioUrl', 'dominioProprio',
          'status', 'trialExpiraEmIso', 'onboardingConcluido',
          'planoId', 'planoSlug', 'ciclo', 'valorMensalCentavos',
          'asaasCustomerId', 'adicionaisAtivos', 'featureFlags',
          'createdAt', 'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isOptionalString(data, 'tipoPessoa', 4) &&
        data.cnpj is string && data.cnpj.size() >= 11 && data.cnpj.size() <= 18 &&
        data.razaoSocial is string && data.razaoSocial.size() >= 2 && data.razaoSocial.size() <= 200 &&
        isOptionalString(data, 'nomeFantasia', 200) &&
        isOptionalString(data, 'nomeAdministrador', 160) &&
        data.emailFinanceiro is string && data.emailFinanceiro.size() >= 5 && data.emailFinanceiro.size() <= 160 &&
        data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 32 &&
        isOptionalString(data, 'cupomAplicado', 40) &&
        isOptionalInt(data, 'descontoCupomCentavos') &&
        isOptionalString(data, 'certificadoNomeExibicao', 200) &&
        isOptionalBool(data, 'certificadoExibirDocumento') &&
        isOptionalString(data, 'certificadoTelefoneRodape', 40) &&
        isOptionalString(data, 'certificadoEmailRodape', 160) &&
        isOptionalString(data, 'cep', 12) &&
        isOptionalString(data, 'logradouro', 200) &&
        isOptionalString(data, 'numero', 32) &&
        isOptionalString(data, 'complemento', 120) &&
        isOptionalString(data, 'bairro', 120) &&
        isOptionalString(data, 'endereco', 320) &&
        isOptionalString(data, 'cidade', 100) &&
        isOptionalString(data, 'uf', 4) &&
        isOptionalString(data, 'logoUrl', 450000) &&
        data.corPrimaria is string && data.corPrimaria.size() >= 4 && data.corPrimaria.size() <= 16 &&
        isOptionalString(data, 'corSecundaria', 16) &&
        data.prefixoCertificado is string && data.prefixoCertificado.size() >= 2 && data.prefixoCertificado.size() <= 16 &&
        isOptionalString(data, 'modeloCertificadoId', 128) &&
        isOptionalString(data, 'modeloProprioUrl', 450000) &&
        isOptionalString(data, 'dominioProprio', 128) &&
        isOptionalString(data, 'trialExpiraEmIso', 40) &&
        isOptionalString(data, 'planoId', 128) &&
        isOptionalString(data, 'planoSlug', 64) &&
        isOptionalString(data, 'ciclo', 20) &&
        isOptionalInt(data, 'valorMensalCentavos') &&
        isOptionalString(data, 'asaasCustomerId', 128) &&
        (!('adicionaisAtivos' in data) || (data.adicionaisAtivos is list && data.adicionaisAtivos.size() <= 20)) &&
        (!('featureFlags' in data) || data.featureFlags is map) &&
        data.status in ['TRIAL', 'ATIVA', 'INADIMPLENTE', 'SUSPENSA', 'CANCELADA'] &&
        data.onboardingConcluido is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidMembro(data) {
      return data.keys().hasAll(['uid', 'empresaId', 'nome', 'email', 'perfil', 'ativo', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'empresaId', 'nome', 'email', 'perfil', 'registroProfissional', 'cargo', 'ativo', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 140 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.perfil in ['ADMIN_EMPRESA', 'RT', 'INSTRUTOR_TST'] &&
        isOptionalString(data, 'registroProfissional', 64) &&
        isOptionalString(data, 'cargo', 100) &&
        data.ativo is bool &&
        isValidTimestamp(data.createdAt) &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidFatura(data) {
      return data.keys().hasAll([
          'empresaId', 'descricao', 'valorCentavos', 'status',
          'metodoPagamento', 'tipoItem', 'vencimentoIso', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'empresaId', 'descricao', 'valorCentavos', 'status',
          'metodoPagamento', 'tipoItem', 'itemSlug', 'ciclo',
          'asaasPaymentId', 'pixQrCodePayload', 'pixQrCodeSvg',
          'invoiceUrl', 'modoIntegracao', 'vencimentoIso', 'pagoEmIso',
          'createdAt', 'updatedAt'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.descricao is string && data.descricao.size() >= 3 && data.descricao.size() <= 240 &&
        data.valorCentavos is int && data.valorCentavos >= 0 &&
        data.status in ['PENDENTE', 'PAGA', 'VENCIDA', 'CANCELADA', 'ESTORNADA'] &&
        data.metodoPagamento in ['PIX', 'CARTAO_CREDITO', 'BOLETO'] &&
        data.tipoItem in ['PLANO', 'ADICIONAL', 'UPGRADE'] &&
        isOptionalString(data, 'itemSlug', 80) &&
        isOptionalString(data, 'ciclo', 20) &&
        isOptionalString(data, 'asaasPaymentId', 128) &&
        isOptionalString(data, 'pixQrCodePayload', 1000) &&
        isOptionalString(data, 'pixQrCodeSvg', 120000) &&
        isOptionalString(data, 'invoiceUrl', 500) &&
        isOptionalString(data, 'modoIntegracao', 64) &&
        data.vencimentoIso is string && data.vencimentoIso.size() <= 40 &&
        isOptionalString(data, 'pagoEmIso', 40) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidObra(data) {
      return data.keys().hasAll(['empresaId', 'codigo', 'nome', 'ativo', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'empresaId', 'codigo', 'nome', 'clienteFinal', 'localizacao',
          'cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf',
          'ativo', 'createdAt', 'updatedAt'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.codigo is string && data.codigo.size() >= 1 && data.codigo.size() <= 64 &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 180 &&
        isOptionalString(data, 'clienteFinal', 180) &&
        isOptionalString(data, 'localizacao', 260) &&
        isOptionalString(data, 'cep', 12) &&
        isOptionalString(data, 'logradouro', 200) &&
        isOptionalString(data, 'numero', 32) &&
        isOptionalString(data, 'complemento', 120) &&
        isOptionalString(data, 'bairro', 120) &&
        isOptionalString(data, 'cidade', 100) &&
        isOptionalString(data, 'uf', 4) &&
        data.ativo is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidColaborador(data) {
      return data.keys().hasAll(['empresaId', 'nome', 'cpf', 'funcao', 'ativo', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'empresaId', 'contratoObraId', 'contratoObraNome', 'nome', 'cpf',
          'rg', 'funcao', 'matricula', 'email', 'telefone',
          'cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf',
          'ativo', 'createdAt', 'updatedAt'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        isOptionalString(data, 'contratoObraId', 128) &&
        isOptionalString(data, 'contratoObraNome', 180) &&
        data.nome is string && data.nome.size() >= 2 && data.nome.size() <= 160 &&
        data.cpf is string && data.cpf.size() >= 11 && data.cpf.size() <= 18 &&
        isOptionalString(data, 'rg', 32) &&
        data.funcao is string && data.funcao.size() >= 2 && data.funcao.size() <= 120 &&
        isOptionalString(data, 'matricula', 40) &&
        isOptionalString(data, 'email', 160) &&
        isOptionalString(data, 'telefone', 32) &&
        isOptionalString(data, 'cep', 12) &&
        isOptionalString(data, 'logradouro', 200) &&
        isOptionalString(data, 'numero', 32) &&
        isOptionalString(data, 'complemento', 120) &&
        isOptionalString(data, 'bairro', 120) &&
        isOptionalString(data, 'cidade', 100) &&
        isOptionalString(data, 'uf', 4) &&
        data.ativo is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAssinaturaDigital(data) {
      return data.keys().hasAll(['empresaId', 'tipo', 'nomeSignatario', 'imagemDataUrl', 'ativa', 'createdAt']) &&
        data.keys().hasOnly(['empresaId', 'usuarioUid', 'tipo', 'nomeSignatario', 'registro', 'imagemDataUrl', 'ativa', 'createdAt']) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        isOptionalString(data, 'usuarioUid', 128) &&
        data.tipo in ['INSTRUTOR', 'RT', 'EMPRESA'] &&
        data.nomeSignatario is string && data.nomeSignatario.size() >= 2 && data.nomeSignatario.size() <= 140 &&
        isOptionalString(data, 'registro', 80) &&
        data.imagemDataUrl is string && data.imagemDataUrl.size() >= 20 && data.imagemDataUrl.size() <= 200000 &&
        data.ativa is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidTreinamentoEmpresa(data) {
      return data.keys().hasAll([
          'empresaId', 'nrCodigo', 'nrTitulo', 'variacaoNome', 'modalidade',
          'cargaHorariaHoras', 'validadeMeses', 'notaMinimaAprovacao',
          'conteudoLinhas', 'ativo', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'empresaId', 'nrCodigo', 'nrTitulo', 'variacaoNome', 'modalidade',
          'cargaHorariaHoras', 'validadeMeses', 'notaMinimaAprovacao',
          'baseLegal', 'conteudoLinhas', 'ativo', 'createdAt', 'updatedAt'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.nrCodigo is string && data.nrCodigo.size() >= 2 && data.nrCodigo.size() <= 20 &&
        data.nrTitulo is string && data.nrTitulo.size() >= 2 && data.nrTitulo.size() <= 240 &&
        data.variacaoNome is string && data.variacaoNome.size() >= 2 && data.variacaoNome.size() <= 160 &&
        data.modalidade in ['INICIAL', 'RECICLAGEM', 'COMPLEMENTAR'] &&
        data.cargaHorariaHoras is int && data.cargaHorariaHoras >= 1 && data.cargaHorariaHoras <= 500 &&
        data.validadeMeses is int && data.validadeMeses >= 1 && data.validadeMeses <= 120 &&
        data.notaMinimaAprovacao is int && data.notaMinimaAprovacao >= 0 && data.notaMinimaAprovacao <= 100 &&
        isOptionalString(data, 'baseLegal', 240) &&
        data.conteudoLinhas is list && data.conteudoLinhas.size() <= 60 &&
        (data.conteudoLinhas.size() == 0 || data.conteudoLinhas[0] is map) &&
        data.ativo is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidQuestao(data) {
      return data.keys().hasAll(['empresaId', 'treinamentoId', 'enunciado', 'alternativas', 'correta', 'ativa', 'createdAt']) &&
        data.keys().hasOnly(['empresaId', 'treinamentoId', 'enunciado', 'alternativas', 'correta', 'peso', 'ativa', 'createdAt', 'updatedAt']) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.treinamentoId is string && data.treinamentoId.size() >= 1 && data.treinamentoId.size() <= 128 &&
        data.enunciado is string && data.enunciado.size() >= 5 && data.enunciado.size() <= 1000 &&
        data.alternativas is list && data.alternativas.size() >= 2 && data.alternativas.size() <= 6 &&
        data.alternativas[0] is map &&
        data.correta is string && data.correta.size() >= 1 && data.correta.size() <= 4 &&
        isOptionalInt(data, 'peso') &&
        data.ativa is bool &&
        isValidTimestamp(data.createdAt) &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidTurma(data) {
      return data.keys().hasAll([
          'empresaId', 'treinamentoId', 'codigoTurma', 'titulo',
          'dataRealizacaoIso', 'tokenPublico', 'modoIdentificacao',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'empresaId', 'treinamentoId', 'treinamentoResumo', 'nrCodigo',
          'cargaHorariaHoras', 'validadeMeses', 'notaMinimaAprovacao',
          'contratoObraId', 'contratoObraNome', 'instrutorNome', 'instrutorRegistro',
          'rtNome', 'rtRegistro', 'codigoTurma', 'titulo', 'dataRealizacaoIso',
          'localRealizacao', 'tokenPublico', 'modoIdentificacao', 'pinAcesso',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.treinamentoId is string && data.treinamentoId.size() >= 1 && data.treinamentoId.size() <= 128 &&
        isOptionalString(data, 'treinamentoResumo', 220) &&
        isOptionalString(data, 'nrCodigo', 20) &&
        isOptionalNumber(data, 'cargaHorariaHoras') &&
        isOptionalNumber(data, 'validadeMeses') &&
        isOptionalNumber(data, 'notaMinimaAprovacao') &&
        isOptionalString(data, 'contratoObraId', 128) &&
        isOptionalString(data, 'contratoObraNome', 180) &&
        isOptionalString(data, 'instrutorNome', 140) &&
        isOptionalString(data, 'instrutorRegistro', 80) &&
        isOptionalString(data, 'rtNome', 140) &&
        isOptionalString(data, 'rtRegistro', 80) &&
        data.codigoTurma is string && data.codigoTurma.size() >= 2 && data.codigoTurma.size() <= 64 &&
        data.titulo is string && data.titulo.size() >= 2 && data.titulo.size() <= 200 &&
        data.dataRealizacaoIso is string && data.dataRealizacaoIso.size() <= 40 &&
        isOptionalString(data, 'localRealizacao', 200) &&
        data.tokenPublico is string && data.tokenPublico.size() >= 6 && data.tokenPublico.size() <= 64 &&
        data.modoIdentificacao in ['CPF', 'CPF_PIN', 'CPF_PIN_SELFIE'] &&
        isOptionalString(data, 'pinAcesso', 16) &&
        data.status in ['RASCUNHO', 'ABERTA', 'ENCERRADA', 'CANCELADA'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidProvaTentativa(data) {
      return data.keys().hasAll([
          'empresaId', 'turmaId', 'colaboradorId', 'colaboradorNome',
          'colaboradorCpf', 'respostas', 'notaPercentual', 'status', 'concluidaEm'
        ]) &&
        data.keys().hasOnly([
          'empresaId', 'turmaId', 'tokenPublico', 'colaboradorId', 'colaboradorNome',
          'colaboradorCpf', 'respostas', 'notaPercentual', 'acertos', 'totalQuestoes',
          'status', 'assinaturaDataUrl', 'selfieDataUrl', 'concluidaEm'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.turmaId is string && data.turmaId.size() >= 1 && data.turmaId.size() <= 128 &&
        isOptionalString(data, 'tokenPublico', 64) &&
        data.colaboradorId is string && data.colaboradorId.size() >= 1 && data.colaboradorId.size() <= 128 &&
        data.colaboradorNome is string && data.colaboradorNome.size() >= 2 && data.colaboradorNome.size() <= 160 &&
        data.colaboradorCpf is string && data.colaboradorCpf.size() >= 11 && data.colaboradorCpf.size() <= 18 &&
        data.respostas is map &&
        data.notaPercentual is int && data.notaPercentual >= 0 && data.notaPercentual <= 100 &&
        isOptionalInt(data, 'acertos') &&
        isOptionalInt(data, 'totalQuestoes') &&
        data.status in ['EM_ANDAMENTO', 'APROVADO', 'REPROVADO'] &&
        isOptionalString(data, 'assinaturaDataUrl', 200000) &&
        isOptionalString(data, 'selfieDataUrl', 300000) &&
        isValidTimestamp(data.concluidaEm);
    }

    function isValidCertificadoTenant(data) {
      return data.keys().hasAll([
          'empresaId', 'turmaId', 'colaboradorId', 'numeroCertificado',
          'codigoValidacaoQr', 'nrCodigo', 'treinamentoTitulo',
          'cargaHorariaHoras', 'dataRealizacaoIso', 'dataValidadeIso',
          'status', 'snapshotConteudoLinhas', 'snapshotEmpresa',
          'snapshotColaborador', 'emitidoEm'
        ]) &&
        data.keys().hasOnly([
          'empresaId', 'turmaId', 'contratoObraId', 'contratoObraNome',
          'colaboradorId', 'numeroCertificado', 'codigoValidacaoQr',
          'nrCodigo', 'treinamentoTitulo', 'cargaHorariaHoras',
          'dataRealizacaoIso', 'dataValidadeIso', 'status',
          'snapshotConteudoLinhas', 'snapshotEmpresa', 'snapshotColaborador',
          'emitidoEm', 'updatedAt'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.turmaId is string && data.turmaId.size() >= 1 && data.turmaId.size() <= 128 &&
        isOptionalString(data, 'contratoObraId', 128) &&
        isOptionalString(data, 'contratoObraNome', 180) &&
        data.colaboradorId is string && data.colaboradorId.size() >= 1 && data.colaboradorId.size() <= 128 &&
        data.numeroCertificado is string && data.numeroCertificado.size() >= 3 && data.numeroCertificado.size() <= 64 &&
        data.codigoValidacaoQr is string && data.codigoValidacaoQr.size() >= 6 && data.codigoValidacaoQr.size() <= 64 &&
        data.nrCodigo is string && data.nrCodigo.size() >= 2 && data.nrCodigo.size() <= 20 &&
        data.treinamentoTitulo is string && data.treinamentoTitulo.size() >= 3 && data.treinamentoTitulo.size() <= 240 &&
        data.cargaHorariaHoras is int && data.cargaHorariaHoras >= 1 && data.cargaHorariaHoras <= 500 &&
        data.dataRealizacaoIso is string && data.dataRealizacaoIso.size() <= 40 &&
        data.dataValidadeIso is string && data.dataValidadeIso.size() <= 40 &&
        data.status in ['EMITIDO', 'REVOGADO'] &&
        data.snapshotConteudoLinhas is list && data.snapshotConteudoLinhas.size() <= 60 &&
        data.snapshotEmpresa is map &&
        data.snapshotColaborador is map &&
        isValidTimestamp(data.emitidoEm) &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidCartaAnuencia(data) {
      return data.keys().hasAll([
          'empresaId', 'colaboradorId', 'colaboradorNome', 'titulo',
          'nrReferencia', 'textoLegal', 'validadeIso', 'emitidaEm'
        ]) &&
        data.keys().hasOnly([
          'empresaId', 'colaboradorId', 'colaboradorNome', 'titulo',
          'nrReferencia', 'textoLegal', 'responsavelNome', 'assinaturaRespUrl',
          'validadeIso', 'emitidaEm'
        ]) &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.colaboradorId is string && data.colaboradorId.size() >= 1 && data.colaboradorId.size() <= 128 &&
        data.colaboradorNome is string && data.colaboradorNome.size() >= 2 && data.colaboradorNome.size() <= 160 &&
        data.titulo is string && data.titulo.size() >= 3 && data.titulo.size() <= 200 &&
        data.nrReferencia is string && data.nrReferencia.size() >= 2 && data.nrReferencia.size() <= 40 &&
        data.textoLegal is string && data.textoLegal.size() >= 10 && data.textoLegal.size() <= 4000 &&
        isOptionalString(data, 'responsavelNome', 140) &&
        isOptionalString(data, 'assinaturaRespUrl', 200000) &&
        data.validadeIso is string && data.validadeIso.size() <= 40 &&
        isValidTimestamp(data.emitidaEm);
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS — PORTAIS PÚBLICOS, ANALYTICS & NOTIFICAÇÕES
    // =========================================================================

    function isValidCertificadoPublico(data) {
      return data.keys().hasAll([
          'codigoValidacaoQr', 'empresaId', 'numeroCertificado', 'nrCodigo',
          'treinamentoTitulo', 'colaboradorNome', 'colaboradorCpfMascarado',
          'empresaRazaoSocial', 'cargaHorariaHoras', 'status', 'emitidoEm'
        ]) &&
        data.keys().hasOnly([
          'codigoValidacaoQr', 'empresaId', 'numeroCertificado', 'nrCodigo',
          'treinamentoTitulo', 'colaboradorNome', 'colaboradorCpfMascarado',
          'empresaRazaoSocial', 'empresaCnpj', 'cargaHorariaHoras',
          'dataRealizacao', 'dataValidade', 'status',
          'snapshotConteudoLinhas', 'emitidoEm', 'updatedAt'
        ]) &&
        data.codigoValidacaoQr is string && data.codigoValidacaoQr.size() >= 6 && data.codigoValidacaoQr.size() <= 64 &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.numeroCertificado is string && data.numeroCertificado.size() >= 3 && data.numeroCertificado.size() <= 64 &&
        data.nrCodigo is string && data.nrCodigo.size() >= 2 && data.nrCodigo.size() <= 20 &&
        data.treinamentoTitulo is string && data.treinamentoTitulo.size() >= 3 && data.treinamentoTitulo.size() <= 240 &&
        data.colaboradorNome is string && data.colaboradorNome.size() >= 2 && data.colaboradorNome.size() <= 160 &&
        data.colaboradorCpfMascarado is string && data.colaboradorCpfMascarado.size() >= 6 && data.colaboradorCpfMascarado.size() <= 20 &&
        data.empresaRazaoSocial is string && data.empresaRazaoSocial.size() >= 2 && data.empresaRazaoSocial.size() <= 200 &&
        isOptionalString(data, 'empresaCnpj', 20) &&
        data.cargaHorariaHoras is int && data.cargaHorariaHoras >= 1 && data.cargaHorariaHoras <= 500 &&
        isOptionalString(data, 'dataRealizacao', 32) &&
        isOptionalString(data, 'dataValidade', 32) &&
        (!('snapshotConteudoLinhas' in data) || (data.snapshotConteudoLinhas is list && data.snapshotConteudoLinhas.size() <= 60)) &&
        data.status in ['EMITIDO', 'REVOGADO'] &&
        isValidTimestamp(data.emitidoEm) &&
        isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidTurmaPublica(data) {
      return data.keys().hasAll([
          'tokenPublico', 'empresaId', 'turmaId', 'empresaRazaoSocial',
          'titulo', 'nrCodigo', 'cargaHorariaHoras', 'notaMinimaAprovacao',
          'modoIdentificacao', 'questoesPublicas', 'status', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'tokenPublico', 'empresaId', 'turmaId', 'empresaRazaoSocial',
          'empresaCorPrimaria', 'empresaLogoUrl', 'titulo', 'nrCodigo',
          'cargaHorariaHoras', 'notaMinimaAprovacao', 'modoIdentificacao',
          'exigePin', 'pinHash', 'questoesPublicas', 'status', 'updatedAt'
        ]) &&
        data.tokenPublico is string && data.tokenPublico.size() >= 6 && data.tokenPublico.size() <= 64 &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.turmaId is string && data.turmaId.size() >= 1 && data.turmaId.size() <= 128 &&
        data.empresaRazaoSocial is string && data.empresaRazaoSocial.size() >= 2 && data.empresaRazaoSocial.size() <= 200 &&
        isOptionalString(data, 'empresaCorPrimaria', 16) &&
        isOptionalString(data, 'empresaLogoUrl', 450000) &&
        data.titulo is string && data.titulo.size() >= 2 && data.titulo.size() <= 200 &&
        data.nrCodigo is string && data.nrCodigo.size() >= 2 && data.nrCodigo.size() <= 20 &&
        data.cargaHorariaHoras is number && data.cargaHorariaHoras >= 1 &&
        data.notaMinimaAprovacao is number && data.notaMinimaAprovacao >= 0 && data.notaMinimaAprovacao <= 100 &&
        data.modoIdentificacao in ['CPF', 'CPF_PIN', 'CPF_PIN_SELFIE'] &&
        isOptionalBool(data, 'exigePin') &&
        isOptionalString(data, 'pinHash', 128) &&
        data.questoesPublicas is list && data.questoesPublicas.size() <= 50 &&
        data.status in ['RASCUNHO', 'ABERTA', 'ENCERRADA', 'CANCELADA'] &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidDossiePublico(data) {
      return data.keys().hasAll([
          'token', 'empresaId', 'colaboradorId', 'empresaRazaoSocial',
          'colaboradorNome', 'colaboradorCpfMascarado', 'colaboradorFuncao',
          'certificados', 'cartasAnuencia', 'expiraEmIso', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'token', 'empresaId', 'colaboradorId', 'empresaRazaoSocial',
          'colaboradorNome', 'colaboradorCpfMascarado', 'colaboradorFuncao',
          'certificados', 'cartasAnuencia', 'provasResumo', 'expiraEmIso', 'createdAt'
        ]) &&
        data.token is string && data.token.size() >= 8 && data.token.size() <= 64 &&
        data.empresaId is string && data.empresaId.size() >= 1 && data.empresaId.size() <= 128 &&
        data.colaboradorId is string && data.colaboradorId.size() >= 1 && data.colaboradorId.size() <= 128 &&
        data.empresaRazaoSocial is string && data.empresaRazaoSocial.size() <= 200 &&
        data.colaboradorNome is string && data.colaboradorNome.size() <= 160 &&
        data.colaboradorCpfMascarado is string && data.colaboradorCpfMascarado.size() <= 20 &&
        data.colaboradorFuncao is string && data.colaboradorFuncao.size() <= 120 &&
        data.certificados is list && data.certificados.size() <= 100 &&
        data.cartasAnuencia is list && data.cartasAnuencia.size() <= 50 &&
        (!('provasResumo' in data) || (data.provasResumo is list && data.provasResumo.size() <= 100)) &&
        data.expiraEmIso is string && data.expiraEmIso.size() <= 40 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidNotificacaoAdmin(data) {
      return data.keys().hasAll(['tipo', 'titulo', 'mensagem', 'lida', 'createdAt']) &&
        data.keys().hasOnly(['tipo', 'titulo', 'mensagem', 'empresaId', 'empresaNome', 'lida', 'createdAt']) &&
        data.tipo in ['NOVO_TRIAL', 'NOVA_VENDA', 'UPGRADE', 'ADICIONAL_CONTRATADO', 'PAGAMENTO_ATRASADO', 'TRIAL_EXPIRANDO'] &&
        data.titulo is string && data.titulo.size() >= 3 && data.titulo.size() <= 160 &&
        data.mensagem is string && data.mensagem.size() >= 3 && data.mensagem.size() <= 600 &&
        isOptionalString(data, 'empresaId', 128) &&
        isOptionalString(data, 'empresaNome', 200) &&
        data.lida is bool &&
        isValidTimestamp(data.createdAt);
    }

    function isValidAnalyticsHeartbeat(data) {
      return data.keys().hasAll(['sessaoId', 'rota', 'origem', 'ultimoPingEm']) &&
        data.keys().hasOnly(['sessaoId', 'rota', 'origem', 'empresaId', 'usuarioUid', 'ultimoPingEm']) &&
        data.sessaoId is string && data.sessaoId.size() >= 6 && data.sessaoId.size() <= 64 &&
        data.rota is string && data.rota.size() >= 1 && data.rota.size() <= 200 &&
        data.origem in ['SITE', 'APP', 'ADMIN', 'PROVA_PUBLICA', 'VALIDACAO_QR'] &&
        isOptionalString(data, 'empresaId', 128) &&
        isOptionalString(data, 'usuarioUid', 128) &&
        isValidTimestamp(data.ultimoPingEm);
    }

    // =========================================================================
    // 1. COLEÇÕES GLOBAIS DO CATÁLOGO DK FACILITA
    // =========================================================================

    match /planos/{planoId} {
      allow get: if isValidId(planoId);
      allow list: if resource.data.ativo == true || isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(planoId) && isValidPlano(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(planoId);
    }

    match /adicionais/{adicionalId} {
      allow get: if isValidId(adicionalId);
      allow list: if resource.data.ativo == true || isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(adicionalId) && isValidAdicional(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(adicionalId);
    }

    match /nrs_globais/{nrId} {
      allow get: if isValidId(nrId);
      allow list: if resource.data.ativa == true || isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(nrId) && isValidNrGlobal(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(nrId);
    }

    match /modelos_certificado_globais/{modeloId} {
      allow get: if isValidId(modeloId);
      allow list: if resource.data.ativo == true || isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(modeloId) && isValidModeloCertificado(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(modeloId);
    }

    match /admins/{adminUid} {
      allow get: if isSuperAdmin() && isValidId(adminUid);
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /notificacoes_admin/{notificacaoId} {
      allow get: if isSuperAdmin() && isValidId(notificacaoId);
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && isValidId(notificacaoId) && isValidNotificacaoAdmin(incoming()) && incoming().lida == false && incoming().createdAt == request.time;
      allow update: if isSuperAdmin() && isValidId(notificacaoId) && isValidNotificacaoAdmin(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isSuperAdmin() && isValidId(notificacaoId);
    }

    // Site & Campanhas (CMS) — leitura pública na Landing Page, escrita exclusiva do Super Admin
    match /site_cms/{docId} {
      allow get: if isValidId(docId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(docId) &&
        incoming().keys().hasAll(['faixaTopo', 'carrosselSlides', 'cardsPromocionais', 'updatedAt']) &&
        incoming().faixaTopo is map &&
        incoming().carrosselSlides is list && incoming().carrosselSlides.size() <= 10 &&
        incoming().cardsPromocionais is list && incoming().cardsPromocionais.size() <= 12 &&
        incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(docId);
    }

    // Cupons de Desconto — validação pública por código, CRUD exclusivo do Super Admin
    match /cupons/{cupomId} {
      allow get: if isValidId(cupomId);
      allow list: if isSuperAdmin() || resource.data.ativo == true;
      allow create: if isSuperAdmin() && isValidId(cupomId) &&
        incoming().keys().hasAll(['codigo', 'tipoDesconto', 'valorDesconto', 'planosAplicaveis', 'ciclosAplicaveis', 'limiteUsos', 'usosAtuais', 'ativo', 'updatedAt']) &&
        incoming().codigo is string && incoming().codigo.size() >= 3 && incoming().codigo.size() <= 40 &&
        incoming().tipoDesconto in ['PERCENTUAL', 'FIXO'] &&
        incoming().valorDesconto is int && incoming().valorDesconto >= 1 &&
        incoming().limiteUsos is int && incoming().limiteUsos >= 0 &&
        incoming().usosAtuais is int && incoming().usosAtuais >= 0 &&
        incoming().ativo is bool &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(cupomId) && incoming().updatedAt == request.time && (
        (
          isSuperAdmin() &&
          incoming().codigo is string && incoming().codigo.size() >= 3 && incoming().codigo.size() <= 40 &&
          incoming().tipoDesconto in ['PERCENTUAL', 'FIXO'] &&
          incoming().valorDesconto is int && incoming().valorDesconto >= 1
        ) ||
        (
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['usosAtuais', 'updatedAt']) &&
          incoming().usosAtuais == existing().usosAtuais + 1
        )
      );
      allow delete: if isSuperAdmin() && isValidId(cupomId);
    }

    // Central de Comunicados (Dono -> Empresas Clientes)
    match /comunicados/{comunicadoId} {
      allow get: if isValidId(comunicadoId) && (isSuperAdmin() || (isSignedIn() && resource.data.status in ['ATIVO', 'AGENDADO']));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.status in ['ATIVO', 'AGENDADO']);
      allow create, update: if isSuperAdmin() && isValidId(comunicadoId) &&
        incoming().keys().hasAll(['titulo', 'mensagem', 'tipo', 'exibirPopup', 'publicoAlvo', 'repeticao', 'status', 'updatedAt']) &&
        incoming().titulo is string && incoming().titulo.size() >= 2 && incoming().titulo.size() <= 160 &&
        incoming().mensagem is string && incoming().mensagem.size() >= 2 && incoming().mensagem.size() <= 2000 &&
        incoming().tipo in ['INFORMATIVO', 'MANUTENCAO', 'NOVIDADE', 'URGENTE'] &&
        incoming().exibirPopup is bool &&
        incoming().publicoAlvo in ['TODAS', 'ATIVAS', 'TRIAL', 'PLANO_ESPECIFICO'] &&
        incoming().repeticao in ['UNICO', 'DIARIO', 'SEMANAL', 'MENSAL'] &&
        incoming().status in ['RASCUNHO', 'AGENDADO', 'ATIVO', 'ENCERRADO'] &&
        incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidId(comunicadoId);
    }

    // =========================================================================
    // 2. EMPRESAS & SUBCOLEÇÕES ISOLADAS POR empresa_id (MASTER GATE)
    // =========================================================================

    match /empresas/{empresaId} {
      allow get: if isValidId(empresaId) && (isSuperAdmin() || isTenantMember(empresaId));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(empresaId) &&
        isValidEmpresa(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().status in ['TRIAL', 'ATIVA'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(empresaId) &&
        isValidEmpresa(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          (
            isTenantOwner(empresaId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nomeFantasia', 'whatsapp',
              'certificadoNomeExibicao', 'certificadoExibirDocumento',
              'certificadoTelefoneRodape', 'certificadoEmailRodape',
              'cep', 'logradouro', 'numero', 'complemento', 'bairro',
              'endereco', 'cidade', 'uf',
              'logoUrl', 'corPrimaria', 'corSecundaria', 'prefixoCertificado',
              'modeloCertificadoId', 'onboardingConcluido', 'planoId',
              'planoSlug', 'ciclo', 'valorMensalCentavos', 'adicionaisAtivos',
              'status', 'asaasCustomerId', 'updatedAt'
            ])
          )
        );

      allow delete: if isSuperAdmin() && isValidId(empresaId);

      // Membros RBAC
      match /membros/{memberUid} {
        allow get: if isValidId(empresaId) && isValidId(memberUid) && (
          isSuperAdmin() || isTenantMember(empresaId) || (isSignedIn() && memberUid == request.auth.uid)
        );
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(memberUid) &&
          isValidMembro(incoming()) &&
          incoming().empresaId == empresaId &&
          incoming().createdAt == request.time &&
          (isSuperAdmin() || isTenantOwner(empresaId));
        allow update: if isValidId(empresaId) && isValidId(memberUid) &&
          isValidMembro(incoming()) &&
          incoming().empresaId == existing().empresaId &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          (isSuperAdmin() || (isTenantOwner(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'perfil', 'registroProfissional', 'cargo', 'ativo', 'updatedAt'])));
        allow delete: if isValidId(empresaId) && isValidId(memberUid) && (isSuperAdmin() || isTenantOwner(empresaId));
      }

      // Faturas Asaas
      match /faturas/{faturaId} {
        allow get: if isValidId(empresaId) && isValidId(faturaId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(faturaId) &&
          isValidFatura(incoming()) &&
          incoming().empresaId == empresaId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || isTenantOwner(empresaId));
        allow update: if isValidId(empresaId) && isValidId(faturaId) &&
          isValidFatura(incoming()) &&
          incoming().empresaId == existing().empresaId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isTenantOwner(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'pagoEmIso', 'asaasPaymentId', 'pixQrCodePayload', 'pixQrCodeSvg', 'invoiceUrl', 'updatedAt'])));
        allow delete: if isSuperAdmin() && isValidId(empresaId) && isValidId(faturaId);
      }

      // Contratos / Obras
      match /contratos_obras/{obraId} {
        allow get: if isValidId(empresaId) && isValidId(obraId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(obraId) &&
          isValidObra(incoming()) && incoming().empresaId == empresaId &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow update: if isValidId(empresaId) && isValidId(obraId) &&
          isValidObra(incoming()) && incoming().empresaId == existing().empresaId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isTenantMember(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['codigo', 'nome', 'clienteFinal', 'localizacao', 'cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf', 'ativo', 'updatedAt'])));
        allow delete: if isValidId(empresaId) && isValidId(obraId) && (isSuperAdmin() || isTenantMember(empresaId));
      }

      // Colaboradores
      match /colaboradores/{colaboradorId} {
        allow get: if isValidId(empresaId) && isValidId(colaboradorId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(colaboradorId) &&
          isValidColaborador(incoming()) && incoming().empresaId == empresaId &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow update: if isValidId(empresaId) && isValidId(colaboradorId) &&
          isValidColaborador(incoming()) && incoming().empresaId == existing().empresaId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isTenantMember(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['contratoObraId', 'contratoObraNome', 'nome', 'cpf', 'rg', 'funcao', 'matricula', 'email', 'telefone', 'cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'uf', 'ativo', 'updatedAt'])));
        allow delete: if isValidId(empresaId) && isValidId(colaboradorId) && (isSuperAdmin() || isTenantMember(empresaId));
      }

      // Assinaturas Digitais
      match /assinaturas_digitais/{assinaturaId} {
        allow get: if isValidId(empresaId) && isValidId(assinaturaId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(assinaturaId) &&
          isValidAssinaturaDigital(incoming()) && incoming().empresaId == empresaId &&
          incoming().createdAt == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow delete: if isValidId(empresaId) && isValidId(assinaturaId) && (isSuperAdmin() || isTenantMember(empresaId));
      }

      // Treinamentos da Empresa (Conteúdo Linha por Linha)
      match /treinamentos_empresa/{treinamentoId} {
        allow get: if isValidId(empresaId) && isValidId(treinamentoId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(treinamentoId) &&
          isValidTreinamentoEmpresa(incoming()) && incoming().empresaId == empresaId &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow update: if isValidId(empresaId) && isValidId(treinamentoId) &&
          isValidTreinamentoEmpresa(incoming()) && incoming().empresaId == existing().empresaId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isTenantMember(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['nrCodigo', 'nrTitulo', 'variacaoNome', 'modalidade', 'cargaHorariaHoras', 'validadeMeses', 'notaMinimaAprovacao', 'baseLegal', 'conteudoLinhas', 'ativo', 'updatedAt'])));
        allow delete: if isValidId(empresaId) && isValidId(treinamentoId) && (isSuperAdmin() || isTenantMember(empresaId));
      }

      // Banco de Questões
      match /banco_questoes/{questaoId} {
        allow get: if isValidId(empresaId) && isValidId(questaoId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(questaoId) &&
          isValidQuestao(incoming()) && incoming().empresaId == empresaId &&
          incoming().createdAt == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow update: if isValidId(empresaId) && isValidId(questaoId) &&
          isValidQuestao(incoming()) && incoming().empresaId == existing().empresaId &&
          incoming().createdAt == existing().createdAt &&
          (isSuperAdmin() || (isTenantMember(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['enunciado', 'alternativas', 'correta', 'peso', 'ativa', 'updatedAt'])));
        allow delete: if isValidId(empresaId) && isValidId(questaoId) && (isSuperAdmin() || isTenantMember(empresaId));
      }

      // Turmas e Aplicações
      match /turmas_aplicacoes/{turmaId} {
        allow get: if isValidId(empresaId) && isValidId(turmaId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(turmaId) &&
          isValidTurma(incoming()) && incoming().empresaId == empresaId &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow update: if isValidId(empresaId) && isValidId(turmaId) &&
          isValidTurma(incoming()) && incoming().empresaId == existing().empresaId &&
          incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isTenantMember(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['titulo', 'dataRealizacaoIso', 'localRealizacao', 'modoIdentificacao', 'pinAcesso', 'status', 'notaMinimaAprovacao', 'instrutorNome', 'instrutorRegistro', 'rtNome', 'rtRegistro', 'updatedAt'])));
        allow delete: if isValidId(empresaId) && isValidId(turmaId) && (isSuperAdmin() || isTenantMember(empresaId));
      }

      // Tentativas de Prova (aceita submissão pública autenticada por tokenPublico ativo ou membro da empresa)
      match /provas_tentativas/{tentativaId} {
        allow get: if isValidId(empresaId) && isValidId(tentativaId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(tentativaId) &&
          isValidProvaTentativa(incoming()) &&
          incoming().empresaId == empresaId &&
          incoming().concluidaEm == request.time && (
            isSuperAdmin() ||
            isTenantMember(empresaId) ||
            (
              'tokenPublico' in incoming() &&
              incoming().tokenPublico is string &&
              exists(/databases/$(database)/documents/turmas_publicas/$(incoming().tokenPublico)) &&
              get(/databases/$(database)/documents/turmas_publicas/$(incoming().tokenPublico)).data.empresaId == empresaId &&
              get(/databases/$(database)/documents/turmas_publicas/$(incoming().tokenPublico)).data.status == 'ABERTA'
            )
          );
        allow update, delete: if isSuperAdmin() && isValidId(empresaId) && isValidId(tentativaId);
      }

      // Certificados Emitidos (Snapshot Imutável)
      match /certificados/{certificadoId} {
        allow get: if isValidId(empresaId) && isValidId(certificadoId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(certificadoId) &&
          isValidCertificadoTenant(incoming()) &&
          incoming().empresaId == empresaId &&
          incoming().emitidoEm == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow update: if isValidId(empresaId) && isValidId(certificadoId) &&
          isValidCertificadoTenant(incoming()) &&
          incoming().empresaId == existing().empresaId &&
          incoming().emitidoEm == existing().emitidoEm &&
          incoming().snapshotConteudoLinhas == existing().snapshotConteudoLinhas &&
          (isSuperAdmin() || (existing().status != 'REVOGADO' && isTenantMember(empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])));
        allow delete: if false;
      }

      // Cartas de Anuência
      match /cartas_anuencia/{cartaId} {
        allow get: if isValidId(empresaId) && isValidId(cartaId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow list: if isSuperAdmin() || (isSignedIn() && resource.data.empresaId == empresaId && isTenantMember(empresaId));
        allow create: if isValidId(empresaId) && isValidId(cartaId) &&
          isValidCartaAnuencia(incoming()) && incoming().empresaId == empresaId &&
          incoming().emitidaEm == request.time &&
          (isSuperAdmin() || isTenantMember(empresaId));
        allow delete: if isValidId(empresaId) && isValidId(cartaId) && (isSuperAdmin() || isTenantMember(empresaId));
      }

      // Controle de Comunicados Lidos por Empresa
      match /comunicados_lidos/{comunicadoId} {
        allow get, list: if isValidId(empresaId) && (isSuperAdmin() || isTenantMember(empresaId));
        allow create, update: if isValidId(empresaId) && isValidId(comunicadoId) &&
          (isSuperAdmin() || isTenantMember(empresaId)) &&
          incoming().empresaId == empresaId &&
          incoming().comunicadoId == comunicadoId &&
          incoming().lidoEm == request.time;
        allow delete: if isSuperAdmin() && isValidId(empresaId) && isValidId(comunicadoId);
      }
    }

    // =========================================================================
    // 3. PORTAIS PÚBLICOS (QR CODE SEMPRE ATIVO, PROVA PÚBLICA, DOSSIÊ)
    // =========================================================================

    match /certificados_publicos/{codigoQr} {
      allow get: if isValidId(codigoQr);
      allow list: if false;
      allow create: if isValidId(codigoQr) &&
        isValidCertificadoPublico(incoming()) &&
        incoming().codigoValidacaoQr == codigoQr &&
        incoming().emitidoEm == request.time &&
        (isSuperAdmin() || isTenantMember(incoming().empresaId));
      allow update: if isValidId(codigoQr) &&
        isValidCertificadoPublico(incoming()) &&
        incoming().codigoValidacaoQr == existing().codigoValidacaoQr &&
        incoming().empresaId == existing().empresaId &&
        incoming().emitidoEm == existing().emitidoEm &&
        (isSuperAdmin() || (existing().status != 'REVOGADO' && isTenantMember(existing().empresaId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])));
      allow delete: if false;
    }

    match /turmas_publicas/{tokenPublico} {
      allow get: if isValidId(tokenPublico);
      allow list: if false;
      allow create, update: if isValidId(tokenPublico) &&
        isValidTurmaPublica(incoming()) &&
        incoming().tokenPublico == tokenPublico &&
        incoming().updatedAt == request.time &&
        (isSuperAdmin() || isTenantMember(incoming().empresaId));
      allow delete: if isValidId(tokenPublico) && (isSuperAdmin() || isTenantMember(existing().empresaId));
    }

    match /dossies_publicos/{tokenDossie} {
      allow get: if isValidId(tokenDossie);
      allow list: if false;
      allow create: if isValidId(tokenDossie) &&
        isValidDossiePublico(incoming()) &&
        incoming().token == tokenDossie &&
        incoming().createdAt == request.time &&
        (isSuperAdmin() || isTenantMember(incoming().empresaId));
      allow delete: if isValidId(tokenDossie) && (isSuperAdmin() || isTenantMember(existing().empresaId));
    }

    // =========================================================================
    // 4. ANALYTICS E HEARTBEAT ONLINE (PAINEL SUPER ADMIN)
    // =========================================================================

    match /logs_acesso_analytics/{sessaoId} {
      allow get: if isSuperAdmin() && isValidId(sessaoId);
      allow list: if isSuperAdmin();
      allow create, update: if isValidId(sessaoId) &&
        isValidAnalyticsHeartbeat(incoming()) &&
        incoming().sessaoId == sessaoId &&
        incoming().ultimoPingEm == request.time;
      allow delete: if isSuperAdmin() && isValidId(sessaoId);
    }
  }
}
