    "/empresas/{empresaId}/contratos_obras/{obraId}": { "schema": { "$ref": "#/entities/ContratoObra" }, "description": "Contratos e obras da empresa" },
    "/empresas/{empresaId}/colaboradores/{colaboradorId}": { "schema": { "$ref": "#/entities/Colaborador" }, "description": "Colaboradores da empresa" },
    "/empresas/{empresaId}/assinaturas_digitais/{assinaturaId}": { "schema": { "$ref": "#/entities/AssinaturaDigital" }, "description": "Assinaturas digitalizadas da empresa" },
    "/empresas/{empresaId}/treinamentos_empresa/{treinamentoId}": { "schema": { "$ref": "#/entities/TreinamentoEmpresa" }, "description": "Treinamentos e NRs com conteúdo linha por linha" },
    "/empresas/{empresaId}/banco_questoes/{questaoId}": { "schema": { "$ref": "#/entities/BancoQuestao" }, "description": "Banco de questões da empresa" },
